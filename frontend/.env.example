NEXT_PUBLIC_API_URL=http://localhost:8888
# Public origin of this frontend. Drives Next's `metadataBase`, so og:url and
# og:image resolve to absolute URLs — social crawlers reject relative ones.
# Set this in production or link previews will point at localhost. Also used as
# the SSR/build-time fallback for public status page URLs (in the browser,
# window.location.origin is used automatically).
NEXT_PUBLIC_APP_URL=http://localhost:9999
# Set to "true" only when the API has GOOGLE_CLIENT_ID configured — controls
# whether the "Continue with Google" button renders on /login and /signup.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
