PORT=8888
# Optional graceful-deployment timing (defaults shown, in milliseconds)
HTTP_DRAIN_DELAY_MS=5000
HTTP_SHUTDOWN_TIMEOUT_MS=25000
DATABASE_URL="postgresql://systemvitals:systemvitals@localhost:5432/systemvitals?schema=public"
JWT_SECRET="CHANGE_ME_32_CHARS_MIN"
REDIS_URL="redis://localhost:6379"
QUEUE_ALERT="alert"
# Queue name for organization invite emails (must match the worker's QUEUE_INVITE)
QUEUE_INVITE=invite
# Queue name for email-verification messages (must match the worker's QUEUE_EMAIL_VERIFICATION)
QUEUE_EMAIL_VERIFICATION=email-verification

# Stripe billing (optional — leave blank for non-billing dev/test)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional monthly price-id overrides. If unset, the Stripe bootstrap resolves
# prices by lookup key (systemvitals_signal_month, systemvitals_fleet_month, …).
STRIPE_PRICE_SIGNAL="price_..."
STRIPE_PRICE_FLEET="price_..."
APP_URL="http://localhost:9999"

# Comma-separated emails granted platform-admin on boot (must already have signed up)
ADMIN_EMAILS=

# Google OAuth (optional — omit to disable Google sign-in entirely).
# Create a Web application OAuth client at https://console.cloud.google.com/apis/credentials
# and register <API origin>/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:8888/auth/google/callback"

# Optional SystemVitals-managed Telegram bot. Set all three together or leave
# all three empty to disable new managed Telegram connections.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
