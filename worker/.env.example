DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
REDIS_URL=redis://HOST:6379
QUEUE_ALERT=alert
QUEUE_PROBE=probe
QUEUE_ESCALATION=escalation
# Queue name for organization invite emails (must match the API's QUEUE_INVITE)
QUEUE_INVITE=invite
# Queue name for email-channel verification (must match the API; letters,
# numbers, underscores, and hyphens only)
QUEUE_EMAIL_VERIFICATION=email-verification
WATCHDOG_INTERVAL_MS=30000
PROBE_SCHEDULER_INTERVAL_MS=15000
# Keep at least 3x the longest scheduler interval
SCHEDULER_LEASE_TTL_MS=90000
# Shared deadline for scheduler drain, active BullMQ jobs, and connection cleanup
WORKER_SHUTDOWN_TIMEOUT_MS=45000
# Local readiness heartbeat consumed by the image HEALTHCHECK
WORKER_READINESS_PATH=/tmp/systemvitals-worker-ready
WORKER_READINESS_HEARTBEAT_INTERVAL_MS=5000
WORKER_READINESS_MAX_AGE_SECONDS=30
# Startup migration advisory-lock retry policy
MIGRATION_RETRY_WINDOW_SECONDS=1800
MIGRATION_RETRY_BASE_SECONDS=2
MIGRATION_RETRY_MAX_SECONDS=30
MAIL_FROM=alerts@yourdomain.com
# Public frontend HTTP(S) origin, used to build invite and verification links
APP_URL=http://localhost:9999

# Optional SystemVitals-managed Telegram bot. Use the same token configured on
# the API. Grandfathered custom-token Telegram rows do not require this value.
TELEGRAM_BOT_TOKEN=

# SMTP transport (optional — if unset, a JSON no-op transport is used and emails are logged only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
